<Window x:Class="PerplexityLocalBridge.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Title="Local Perplexity Bridge" Icon="Assets/Bridge.ico" Width="1320" Height="900" MinWidth="1000" MinHeight="700"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">

 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16">
   <StackPanel DockPanel.Dock="Left" MaxWidth="790">
    <StackPanel Orientation="Horizontal"><TextBlock Text="Local Perplexity Bridge" FontSize="26" FontWeight="SemiBold"/><Border CornerRadius="5" Background="{DynamicResource PanelBrush}" Padding="9,4" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="AppVersionBadge" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/></Border></StackPanel>
    <TextBlock x:Name="VersionText" Foreground="{DynamicResource MutedBrush}"/>
    <WrapPanel Margin="0,8,0,0">
     <Button x:Name="UpdateCheckButton" Content="Check for updates" Click="UpdateCheck_Click" ToolTip="Update source not configured for this local release."/>
     <Button x:Name="UpdateDownloadButton" Content="Download update" Click="UpdateDownload_Click" Visibility="Collapsed"/>
     <Button x:Name="UpdateInstallButton" Content="Install and restart" Click="UpdateInstall_Click" Visibility="Collapsed" ToolTip="Verifies the package again, saves settings, and installs a per-user copy. Your Perplexity login, API keys, settings, and endpoint mode are retained."/>
     <Button x:Name="UpdateCancelButton" Content="Cancel" Click="UpdateCancel_Click" Visibility="Collapsed"/>
    </WrapPanel>
    <TextBlock x:Name="UpdateStatusText" Text="Update source not configured" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" MaxWidth="760"/>
    <ProgressBar x:Name="UpdateProgressBar" Height="5" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="0,5,12,0"/>
   </StackPanel>
   <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal"><Ellipse x:Name="ConnectionDot" Width="10" Height="10" Fill="DarkOrange" Margin="0,0,8,0"/><TextBlock x:Name="ConnectionLabel" Text="Perplexity · Checking connection"/></StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,6,0,6"><Ellipse x:Name="EndpointDot" Width="10" Height="10" Fill="Gray" Margin="0,0,8,0"/><TextBlock x:Name="EndpointLabel" Text="Local API · Stopped"/></StackPanel>
    <TextBlock x:Name="HeaderProfileText" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,5" MaxWidth="230" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
    <Button Click="CopyEndpoint_Click" Padding="4" Margin="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" ToolTip="Click to copy the local API base URL. Paste it into your client provider settings."><TextBlock x:Name="EndpointText" Text="Endpoint stopped" FontSize="13"/></Button>
   </StackPanel>
  </DockPanel>
  <Grid x:Name="BodyGrid" Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="SettingsColumn" Width="470"/><ColumnDefinition x:Name="BrowserGap" Width="16"/><ColumnDefinition x:Name="BrowserColumn" Width="*"/></Grid.ColumnDefinitions>
   <TabControl x:Name="SettingsTabs" Background="{DynamicResource WindowBrush}" BorderThickness="0">
<TabItem Header="Accounts"><Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="16"><Grid x:Name="AccountsGrid"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel x:Name="AccountListPanel">
 <TextBlock Text="Perplexity accounts" FontSize="18" FontWeight="SemiBold"/>
 <TextBlock x:Name="ProfileStatusText" Margin="0,6,0,6" FontWeight="SemiBold"/>
 <TextBlock Text="Select a saved login below to view its account identity. Use for API chooses the account that receives requests first." Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
 <ListBox x:Name="ProfilesBox" DisplayMemberPath="Label" Height="125" SelectionChanged="ProfileList_Changed" PreviewMouseRightButtonDown="ProfileList_RightClick">
 <ListBox.ContextMenu><ContextMenu Opened="ProfileMenu_Opened"><MenuItem Header="Use for API / sign in" Click="UseProfile_Click"/><MenuItem Header="Rename profile…" Click="RenameProfile_Click"/><Separator/><MenuItem Header="Remove profile…" Click="RemoveProfile_Click"/></ContextMenu></ListBox.ContextMenu></ListBox>
 <WrapPanel Margin="0,8,0,2"><Button Content="Use for API" Click="UseProfile_Click"/><Button Content="Add account" Click="AddProfile_Click"/><Button x:Name="RemoveProfileButton" Content="Remove…" Click="RemoveProfile_Click"/><Button Content="Move up" Click="MoveProfileUp_Click"/><Button Content="Move down" Click="MoveProfileDown_Click"/></WrapPanel>
 <TextBlock x:Name="ProfileNameHint" Text="Right-click to give this account a custom name." Visibility="Collapsed" Foreground="{DynamicResource AccentBrush}"/>
 </StackPanel><StackPanel x:Name="AccountDetailsPanel" Grid.Column="2">
 <TextBlock x:Name="SelectedAccountText" Margin="0,8,0,6" FontWeight="SemiBold"/>
 <WrapPanel><Button Content="Sign in / open Perplexity" Click="Login_Click"/><Button x:Name="CheckButton" Content="Check selected account" Click="Check_Click"/><Button Content="Check all accounts" Click="CheckAllProfiles_Click"/></WrapPanel>
 <TextBlock Text="Account identity for selected account  ⓘ" Margin="0,8,0,4" ToolTip="Loaded only from the selected login. The first account identity is used when this account has no saved choice."/>
 <ComboBox x:Name="OrgBox" IsEnabled="False" SelectedValuePath="Id" SelectionChanged="Org_Changed" MinHeight="30"/>
 <WrapPanel Margin="0,6,0,0"><CheckBox x:Name="ProfileEnabledBox" Content="Include in API routing" Click="EnableProfile_Click" Margin="0,4,18,4"/><Button Content="Clear this login" Click="SignOut_Click"/><Button Content="Reset pause" Click="ResetProfile_Click" ToolTip="Clears the local timer only; Perplexity's allowance is unchanged."/></WrapPanel>
 <CheckBox x:Name="ShowBrowserBox" Content="Show internal browser  ⓘ" Click="BrowserVisibility_Click" Margin="0,8,0,6" ToolTip="Recommended: off. Show the selected account's browser. Sign-in opens it automatically."/>
 </StackPanel><StackPanel x:Name="AccountRoutingPanel" Grid.Row="1" Grid.ColumnSpan="3">
 <Separator Margin="0,6"/>
 <CheckBox x:Name="ProfileFailoverBox" Content="Try the next account when Perplexity reports a limit  ⓘ" Margin="0,6,0,6" ToolTip="Enabled accounts are tried in list order, once per request. Each login has its own isolated browser session."/>
 <DockPanel><TextBlock Text="Usage-limit pause (minutes)  ⓘ" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="Recommended: 300 (5 hours). Temporary rate limits pause for one minute. These local timers do not change Perplexity's limits."/><TextBox x:Name="ProfileCooldownBox" Padding="6" Width="85" HorizontalAlignment="Left"/></DockPanel>
 <Button Content="Connect Perplexity + start API" Click="Connect_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>
</StackPanel></Grid></Border></TabItem>
<TabItem Header="API"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>     <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="16" Margin="0,12,0,0"><StackPanel>
      <TextBlock Text="Local API" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Text="Port  ⓘ" Margin="0,10,0,4" ToolTip="TCP port for http://127.0.0.1. Recommended: 8082. Range: 1024–65535. Connections are accepted from this PC only."/>
      <TextBox x:Name="PortBox" Padding="7"/>
      <CheckBox x:Name="OpenAiBox" Content="OpenAI-compatible endpoint  ⓘ" Margin="0,12,0,4" ToolTip="Adds /v1/chat/completions. Recommended: enabled for OpenAI SDK clients. Text only; SSE output is buffered until generation finishes."/>
      <CheckBox x:Name="RequireKeyBox" Content="Require a local API key  ⓘ" Margin="0,10,0,4" ToolTip="Recommended: enabled. Turn off to use the endpoint without a key. While disabled, apps on this PC can use the endpoint. It remains bound to 127.0.0.1 and browser-origin requests stay blocked. Use Save all settings to apply."/>
      <CheckBox x:Name="ToolCallingBox" Content="Translate harness tool calls  ⓘ" Margin="0,8,0,4" ToolTip="Recommended: enabled for Pi and OpenCode. Tool definitions and results are sent as structured prompt context. Valid tool calls are returned to the harness for execution. This is prompt-based translation, not native website tool execution."/>
      <TextBlock Text="Request timeout (seconds)  ⓘ" Margin="0,10,0,4" ToolTip="Maximum wait for the whole request, including large-context transfers. Range: 15–600 seconds. Increase it for long coding requests."/>
      <TextBox x:Name="TimeoutBox" Padding="7"/>
      <WrapPanel Margin="0,12,0,0"><Button x:Name="StartButton" Content="Start endpoint" Click="Start_Click"/><Button Content="Stop" Click="Stop_Click"/></WrapPanel>
     </StackPanel></Border><Grid Grid.Column="2">     <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="16" Margin="0,12,0,0"><StackPanel>
      <TextBlock Text="Local API keys  ⓘ" FontSize="18" FontWeight="SemiBold" ToolTip="Keys protect the local endpoint. They are not Perplexity credentials. Recommended: a separate key per client. Only hashes are saved."/>
      <TextBox x:Name="KeyNameBox" Text="My local client" Padding="7" Margin="0,10,0,8" ToolTip="A friendly label for this key. Recommended: the client application name."/>
      <WrapPanel><Button Content="Create key" Click="CreateKey_Click"/><Button Content="Revoke selected" Click="RevokeKey_Click"/></WrapPanel>
      <ListBox x:Name="KeysBox" DisplayMemberPath="Label" Height="75" Margin="0,10,0,8"/>
      <TextBlock Text="New key (shown once)"/>
      <TextBox x:Name="NewKeyBox" IsReadOnly="True" Padding="7" Margin="0,4,0,8"/>
      <Button Content="Copy new key" Click="CopyKey_Click" HorizontalAlignment="Left"/>
     </StackPanel></Border></Grid></Grid></TabItem>
<TabItem Header="Models"><Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="16"><StackPanel><TextBlock Text="Models" FontSize="18" FontWeight="SemiBold"/>      <TextBlock Text="Perplexity web model  ⓘ" Margin="0,8,0,4" ToolTip="Choose a discovered model. perplexity-auto uses the website automatic model; perplexity-web uses your configured default."/>
      <TextBox x:Name="ModelBox" Padding="7"/>
      <ComboBox x:Name="ModelPicker" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Model_Changed" MinHeight="32" Margin="0,8,0,8" ToolTip="Search models discovered from Perplexity’s model configuration and your verified subscription tier. Computer, retired, and upgrade-only entries are excluded. Choose a model, then Save all settings to change the default."/>
      <Button x:Name="ModelsButton" Content="Refresh models from Perplexity" Click="Models_Click" HorizontalAlignment="Left" ToolTip="Reads Perplexity’s model configuration using this account. Refresh after login or switching accounts. The list reflects website availability, not remaining quota."/>
      <TextBlock Text="Large context is transferred in bounded setup messages in the same thread. Setup uses account allowance; later turns send only new history. Sampling controls cannot be enforced. Streaming is buffered." Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0" FontSize="12"/>
      
      <ComboBox x:Name="ThinkingPicker" Visibility="Collapsed" SelectedValuePath="Id"/>
      <TextBlock Text="Thinking variants are separate model selections. Explicit reasoning controls remain unsupported. Web search follows the selected website mode." Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,0"/></StackPanel></Border></TabItem>

<TabItem Header="App"><Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="16"><StackPanel><TextBlock Text="Appearance and startup" FontSize="18" FontWeight="SemiBold"/><Button Content="Set up Pi session tracking" Click="ConfigurePi_Click" HorizontalAlignment="Left" Margin="0,12,0,0" ToolTip="Installs the local Pi session helper, configures this bridge’s key and refreshes Pi’s model list. Run /reload in Pi afterwards."/>      <CheckBox x:Name="DarkModeBox" Content="Dark mode  ⓘ" Margin="0,12,0,0" Click="Theme_Click" ToolTip="Changes this app's colors and the embedded browser's preferred color scheme. Recommended: enabled; dark mode is the default."/>
      <CheckBox x:Name="AutoUpdateBox" Content="Check for updates on startup  ⓘ" Margin="0,10,0,0" Click="AutoUpdate_Click" ToolTip="Update source not configured. Updates are disabled in this local release."/>
      <CheckBox x:Name="AutoStartBox" Content="Resume endpoint on startup  ⓘ" Margin="0,10,0,0" Click="StartupPreference_Click" ToolTip="Recommended: on. After verifying Perplexity, resumes an endpoint previously started successfully. Stop disables resuming until you connect again. First launch waits for Connect."/>
</StackPanel></Border></TabItem>
<TabItem Header="Logs">     <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="16" Margin="0,12,0,0"><StackPanel>
      <TextBlock Text="Diagnostics" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Text="Sends “Reply with exactly OK.” through the local endpoint. Identified agent sessions retain their linked Perplexity thread." Margin="0,8,0,10"/>
      <Button x:Name="TestButton" Content="Test local endpoint → Perplexity" Click="Test_Click"/>
      <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="220" Margin="0,12,0,0" Background="#20252B" Foreground="#EEE" Padding="8" FontFamily="Consolas"/>
     </StackPanel></Border></TabItem>
   <TabItem Header="Sessions"><Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="16"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Agent sessions and projects" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Each identified agent session stays in its original Perplexity thread and account. Thread access data is encrypted on this PC." Margin="0,10,0,10" TextWrapping="Wrap"/><Button Content="Refresh sessions" Click="RefreshSessions_Click" HorizontalAlignment="Left"/></StackPanel><ListBox x:Name="SessionsBox" Margin="0,12,0,0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6"><TextBlock Text="{Binding Project}" FontWeight="SemiBold"/><TextBlock Text="{Binding Details}" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="{Binding Thread}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border></TabItem></TabControl>
   <Grid x:Name="BrowserArea" Grid.Column="2">
   <Border x:Name="ConnectionDashboard" Background="{DynamicResource PanelBrush}" CornerRadius="12" Visibility="Collapsed"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460" Margin="32">
    <Image Source="Assets/Bridge.ico" Width="88" Height="88" Margin="0,0,0,20"/>
    <TextBlock Text="Local Perplexity Bridge" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/>
    <TextBlock x:Name="DashboardStatus" Text="Connected and ready for API requests" FontSize="17" Margin="0,16,0,12" HorizontalAlignment="Center"/>
    <TextBlock Text="Your Perplexity browser session stays active in the background. Use Show internal browser to view it, or right-click the tray icon to connect in one click." Foreground="{DynamicResource MutedBrush}" TextAlignment="Center"/>
    <Button Content="Connect Perplexity + start API" Click="Connect_Click" Margin="0,22,0,0" HorizontalAlignment="Center"/>
   </StackPanel></Border>
   <Grid x:Name="BrowserPanel">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock x:Name="BrowserLocationText" Text="Loading perplexity.ai…" Padding="10" Background="{DynamicResource PanelBrush}" TextTrimming="CharacterEllipsis"/>
    <Grid x:Name="BrowserHost" Grid.Row="1"/>
   </Grid>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="12" Margin="0,12,0,0"><DockPanel>
   <Button x:Name="SaveAllButton" DockPanel.Dock="Left" Content="Save all settings" Click="Save_Click" MinWidth="150"/>
   <TextBlock x:Name="SaveFeedbackText" Text="Settings are up to date." Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0" AutomationProperties.LiveSetting="Polite"/>
  </DockPanel></Border>
  <TextBlock x:Name="StatusText" Grid.Row="3" Text="Starting browser…" Margin="0,14,0,0" FontWeight="SemiBold"/>
 </Grid>
</Window>
